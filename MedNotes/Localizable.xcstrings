            "value" : "Το αντίγραφο ασφαλείας δημιουργήθηκε από νεότερη έκδοση του MedNotes."
          }
        }
      }
    },
    "The backup's %@ count does not match: expected %lld, found %lld." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πλήθος για %@ στο αντίγραφο ασφαλείας δεν ταιριάζει: αναμένονταν %lld, βρέθηκαν %lld."
          }
        }
