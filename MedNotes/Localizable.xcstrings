{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "# Admission — {{patient}}\n_{{date}}_\n\n## Presenting complaint\n- \n\n## History of present illness\n\n\n## Past medical history / medications / allergies\n\n\n## Examination findings\n\n\n## Investigations\n\n\n## Working diagnosis\n\n\n## Initial management plan\n" : {
      "comment" : "Body of a built-in note template, looked up at runtime by its English text (TemplateService.displayed). Keep {{patient}}, {{date}}, [[ ]] and the Markdown as they are.",
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Εισαγωγή — {{patient}}\n_{{date}}_\n\n## Κύρια ενόχληση\n- \n\n## Ιστορικό παρούσας νόσου\n\n\n## Ατομικό αναμνηστικό / φάρμακα / αλλεργίες\n\n\n## Ευρήματα αντικειμενικής εξέτασης\n\n\n## Παρακλινικός έλεγχος\n\n\n## Διάγνωση εργασίας\n\n\n## Αρχικό σχέδιο αντιμετώπισης\n"
          }
        }
      }
    },
    "# Discharge Summary — {{patient}}\n_{{date}}_\n\n## Admission diagnosis\n\n\n## Hospital course\n\n\n## Discharge medications\n\n\n## Follow-up\n- [ ] Appointment: [[ ]]\n\n## Instructions to patient\n" : {
      "comment" : "Body of a built-in note template, looked up at runtime by its English text (TemplateService.displayed). Keep {{patient}}, {{date}}, [[ ]] and the Markdown as they are.",
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Εξιτήριο — {{patient}}\n_{{date}}_\n\n## Διάγνωση εισαγωγής\n\n\n## Πορεία νοσηλείας\n\n\n## Φαρμακευτική αγωγή εξόδου\n\n\n## Παρακολούθηση\n- [ ] Ραντεβού: [[ ]]\n\n## Οδηγίες προς τον ασθενή\n"
          }
        }
      }
    },
    "# SOAP — {{patient}}\n_{{date}}_\n\n## Subjective\n-\n\n## Objective\n-\n\n## Assessment\n-\n\n## Plan\n-" : {
      "comment" : "Body of a built-in note template, looked up at runtime by its English text (TemplateService.displayed). Keep {{patient}}, {{date}}, [[ ]] and the Markdown as they are.",
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# SOAP — {{patient}}\n_{{date}}_\n\n## Υποκειμενικά\n-\n\n## Αντικειμενικά\n-\n\n## Εκτίμηση\n-\n\n## Σχέδιο\n-"
          }
        }
      }
    },
    "%@ The original data could not be put back: %@" : {
      "localizations" : {
