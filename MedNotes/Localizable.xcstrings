    "Restoring replaces every record in MedNotes with this backup. A restore point of the current data is kept first." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά αντικαθιστά κάθε εγγραφή του MedNotes με αυτό το αντίγραφο. Πρώτα διατηρείται σημείο επαναφοράς των τρεχόντων δεδομένων."
          }
        }
      }
    },
    "Revert" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφορά αλλαγών"
          }
        }
      }
    },
    "Runs SQLite's own integrity check and confirms every link between records. Backups are checked the same way before they are trusted." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εκτελεί τον ίδιο τον έλεγχο ακεραιότητας της SQLite και επιβεβαιώνει κάθε σύνδεσμο μεταξύ εγγραφών. Τα αντίγραφα ασφαλείας ελέγχονται με τον ίδιο τρόπο πριν θεωρηθούν αξιόπιστα."
          }
        }
      }
    },
