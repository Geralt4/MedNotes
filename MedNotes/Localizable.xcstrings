    },
    "The backup's final authentication tag is missing." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπει η τελική ετικέτα ελέγχου γνησιότητας του αντιγράφου ασφαλείας."
          }
        }
      }
    },
    "The backup's key-derivation count (%u) is outside the accepted range." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πλήθος επαναλήψεων (%u) για την παραγωγή του κλειδιού του αντιγράφου ασφαλείας είναι εκτός του αποδεκτού εύρους."
          }
        }
      }
    },
    "The backup's records are out of order." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εγγραφές του αντιγράφου ασφαλείας δεν είναι στη σωστή σειρά."
          }
        }
      }
    },
    "The backup's schema is not one MedNotes can restore: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το MedNotes δεν μπορεί να επαναφέρει αντίγραφο ασφαλείας με αυτό το σχήμα βάσης δεδομένων: %@"
          }
        }
      }
    },
    "The chosen calendar no longer exists. Reconnect in Settings › Sync." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ημερολόγιο που επιλέξατε δεν υπάρχει πια. Συνδέστε ξανά το Ημερολόγιο στις Ρυθμίσεις › Συγχρονισμός."
          }
        }
      }
    },
    "The chosen reminder list no longer exists. Reconnect in Settings › Sync." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λίστα υπενθυμίσεων που επιλέξατε δεν υπάρχει πια. Συνδέστε ξανά τις Υπενθυμίσεις στις Ρυθμίσεις › Συγχρονισμός."
          }
        }
      }
    },
    "The database could not be opened: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό το άνοιγμα της βάσης δεδομένων: %@"
          }
        }
      }
    },
    "The database encryption key could not be applied: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η χρήση του κλειδιού κρυπτογράφησης της βάσης δεδομένων: %@"
          }
        }
      }
    },
    "The database file is damaged. SQLite reports: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αρχείο της βάσης δεδομένων έχει καταστραφεί. Η SQLite αναφέρει: %@"
          }
        }
      }
    },
    "The database key is wrong or the file is not an encrypted MedNotes store." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί της βάσης δεδομένων είναι λάθος ή το αρχείο δεν είναι κρυπτογραφημένη βάση δεδομένων MedNotes."
          }
        }
      }
    },
    "The database key must be 64 hex characters (a 256-bit raw key)." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί της βάσης δεδομένων πρέπει να έχει 64 δεκαεξαδικούς χαρακτήρες (ακατέργαστο κλειδί 256 bit)."
          }
        }
      }
    },
    "The database snapshot could not be read." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του στιγμιότυπου της βάσης δεδομένων."
          }
        }
      }
    },
    "The database, attachments and restore points are encrypted with a key held in the macOS Keychain, which requires Touch ID or your account password. MedNotes locks when the screen locks or sleeps, when you switch users, after %lld minutes without activity, and on request." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βάση δεδομένων, τα συνημμένα και τα σημεία επαναφοράς κρυπτογραφούνται με κλειδί που φυλάσσεται στην κλειδοθήκη του macOS και για το οποίο απαιτείται το Touch ID ή το συνθηματικό του λογαριασμού σας. Το MedNotes κλειδώνει όταν η οθόνη κλειδώνει ή τίθεται σε κατάσταση ύπνου, όταν κάνετε εναλλαγή χρηστών, μετά από %lld λεπτά χωρίς δραστηριότητα και όταν το ζητήσετε."
          }
        }
      }
    },
    "The database, attachments and restore points are encrypted with a key in the macOS Keychain; MedNotes locks after five minutes without activity, when the screen locks, and on request. Data leaves the app only when you send records to Calendar or Reminders, run a Markdown export, or open an attachment in another app." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βάση δεδομένων, τα συνημμένα και τα σημεία επαναφοράς κρυπτογραφούνται με κλειδί που φυλάσσεται στην κλειδοθήκη του macOS· το MedNotes κλειδώνει μετά από πέντε λεπτά χωρίς δραστηριότητα, όταν κλειδώνει η οθόνη και όταν το ζητήσετε. Τα δεδομένα φεύγουν από την εφαρμογή μόνο όταν στέλνετε εγγραφές στο Ημερολόγιο ή στις Υπενθυμίσεις, όταν εκτελείτε μια εξαγωγή Markdown ή όταν ανοίγετε ένα συνημμένο σε άλλη εφαρμογή."
          }
        }
      }
    },
    "The device key could not be read from the Keychain (status %d)." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του κλειδιού συσκευής από την κλειδοθήκη (κατάσταση %d)."
          }
        }
      }
    },
    "The device key could not be read from the Keychain (status %d). Try again." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του κλειδιού συσκευής από την κλειδοθήκη (κατάσταση %d). Δοκιμάστε ξανά."
          }
        }
      }
    },
    "The device key has an unexpected length (%lld bytes)." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί συσκευής έχει μη αναμενόμενο μήκος (%lld byte)."
          }
        }
      }
    },
    "The device key is missing" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί συσκευής λείπει"
          }
        }
      }
    },
    "The device key is missing. Restore from a portable backup to recover this data." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κλειδί συσκευής λείπει. Για ανάκτηση αυτών των δεδομένων, επαναφέρετε ένα φορητό αντίγραφο ασφαλείας."
          }
        }
      }
    },
    "The encrypted store could not be installed: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η εγκατάσταση της κρυπτογραφημένης βάσης δεδομένων: %@"
          }
        }
      }
    },
    "The encrypted store failed validation: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επικύρωση της κρυπτογραφημένης βάσης δεδομένων απέτυχε: %@"
          }
        }
      }
    },
    "The encryption migration failed: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετάβαση στην κρυπτογράφηση απέτυχε: %@"
          }
        }
      }
    },
    "The files are readable clinical text. Deleting them cannot be undone; APFS snapshots or backups may still hold copies." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αρχεία περιέχουν αναγνώσιμο κλινικό κείμενο. Η διαγραφή τους δεν μπορεί να αναιρεθεί· ενδέχεται να υπάρχουν ακόμη σε στιγμιότυπα APFS ή σε αντίγραφα ασφαλείας."
          }
        }
      }
    },
    "The first six digits of an AMKA are the birth date (day, month, year); these are not a real date." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα πρώτα έξι ψηφία του ΑΜΚΑ είναι η ημερομηνία γέννησης (ημέρα, μήνας, έτος)· αυτά δεν αποτελούν πραγματική ημερομηνία."
          }
        }
      }
    },
    "The folder is read first into a scratch copy, so the report below is exactly what the import would do. Nothing is written to your records until you choose Import, and a restore point is kept before that." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο φάκελος διαβάζεται πρώτα σε πρόχειρο αντίγραφο, ώστε η παρακάτω αναφορά να είναι ακριβώς αυτό που θα έκανε η εισαγωγή. Τίποτα δεν γράφεται στα αρχεία σας μέχρι να επιλέξετε Εισαγωγή, και πριν από αυτό διατηρείται σημείο επαναφοράς."
          }
        }
      }
    },
    "The graph is empty" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το γράφημα είναι κενό"
          }
        }
      }
    },
    "The Markdown export wrote %lld of %lld notes to “%@”; %lld could not be written. Export again to write them all." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εξαγωγή Markdown έγραψε %lld από τις %lld σημειώσεις στο «%@»· %lld δεν μπόρεσαν να γραφτούν. Εξαγάγετε ξανά για να γραφτούν όλες."
          }
        }
      }
    },
    "The migration journal is unreadable. The original store is untouched." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του αρχείου καταγραφής της μετάβασης. Η αρχική βάση δεδομένων δεν έχει τροποποιηθεί."
          }
        }
      }
    },
    "The passphrase is wrong, or the backup file is damaged." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φράση πρόσβασης είναι λάθος ή το αρχείο αντιγράφου έχει καταστραφεί."
          }
        }
      }
    },
    "The passphrase must be at least 16 characters." : {
      "localizations" : {
