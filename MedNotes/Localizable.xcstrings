      }
    },
    "A copy of your current data could not be made first, so nothing was changed: %@" : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατό να γίνει πρώτα αντίγραφο των τρεχόντων δεδομένων σας, γι' αυτό δεν άλλαξε τίποτα: %@"
          }
